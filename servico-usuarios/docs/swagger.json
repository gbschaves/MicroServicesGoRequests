{
    "swagger": "2.0",
    "info": {
        "description": "Este é o microserviço de usuários.",
        "title": "API de Usuários (Microserviço)",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api/usuarios",
    "paths": {
